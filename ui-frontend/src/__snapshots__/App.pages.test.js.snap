                  />
                  <path
                    d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"
                  />
                  <path
                    d="m3.3 7 8.7 5 8.7-5"
                  />
                  <path
                    d="M12 22V12"
                  />
                </svg>
                 OVF target profile
              </h4>
              <div
                class="space-y-2 mb-4"
              >
                <label
                  class="flex items-start p-3 border rounded-md cursor-pointer border-blue-500 bg-app"
                >
                  <input
                    checked=""
                    class="mt-1 mr-3"
                    name="export-profile"
                    type="radio"
                  />
                  <span
                    class="flex-1"
                  >
                    <span
                      class="block text-main font-medium text-sm"
                    >
                      VMware / vSphere
                    </span>
                    <span
                      class="block text-secondary text-xs mt-0.5"
                    >
                      OVF 1.1 with VMware extensions. virtio devices are remapped to LSI Logic SCSI and E1000E, the hardware ESXi implements.
                    </span>
                  </span>
                </label>
                <label
                  class="flex items-start p-3 border rounded-md cursor-pointer border-main"
                >
                  <input
                    class="mt-1 mr-3"
                    name="export-profile"
                    type="radio"
                  />
                  <span
                    class="flex-1"
                  >
                    <span
                      class="block text-main font-medium text-sm"
                    >
                      Portable (OVF 1.0)
                    </span>
                    <span
                      class="block text-secondary text-xs mt-0.5"
                    >
                      Strict OVF 1.0, no vendor extensions, E1000 NIC. Widest compatibility: VirtualBox, Proxmox, oVirt.
                    </span>
                  </span>
                </label>
                <label
                  class="flex items-start p-3 border rounded-md cursor-pointer border-main"
                >
                  <input
                    class="mt-1 mr-3"
                    name="export-profile"
                    type="radio"
                  />
                  <span
                    class="flex-1"
                  >
                    <span
                      class="block text-main font-medium text-sm"
                    >
                      Faithful (KVM)
                    </span>
                    <span
                      class="block text-secondary text-xs mt-0.5"
                    >
                      Preserves virtio devices verbatim and uses qcow2 disks for a lossless KVM/libvirt round-trip.
                    </span>
                    <span
                      class="block text-xs mt-1 text-red-600 font-medium flex items-center"
                    >
                      <svg
                        class="mr-1 shrink-0"
                        fill="none"
                        height="12"
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                        width="12"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"
                        />
                        <path
                          d="M12 9v4"
                        />
                        <path
                          d="M12 17h.01"
                        />
                      </svg>
                       
                      Will NOT boot on ESXi/vSphere, and ovftool cannot read qcow2-based packages.
                    </span>
                  </span>
                </label>
              </div>
              <div
                class="mb-4 p-3 rounded-md border border-amber-400 bg-amber-50"
              >
                <div
                  class="flex items-center text-amber-800 font-medium text-sm mb-1"
                >
                  <svg
                    class="mr-2"
                    fill="none"
                    height="16"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                    width="16"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"
                    />
                    <path
                      d="M12 9v4"
                    />
                    <path
                      d="M12 17h.01"
                    />
                  </svg>
                   Prepare the guest before exporting
                </div>
                <p
                  class="text-sm text-amber-900"
                >
                  This profile remaps virtio devices to hardware VMware implements. A guest installed on Harvester usually has a 
                  <strong>
                    virtio-only initramfs
                  </strong>
                   and will drop to an emergency shell because it cannot see its own root disk. Run this 
                  <em>
                    inside the VM
                  </em>
                  , then power it off and export:
                </p>
                <pre
                  class="mt-2 p-2 rounded bg-gray-900 text-white text-xs overflow-x-auto"
                >
                  dracut --regenerate-all --force --no-hostonly    # RHEL/SLES/Fedora update-initramfs -u -k all                       # Debian/Ubuntu (MODULES=most)
                </pre>
                <p
                  class="text-xs text-amber-900 mt-1"
                >
                  Windows guests need the LSI Logic / pvscsi storage driver installed and set to boot-start first.
                </p>
              </div>
              <div
                class="mb-4"
              >
                <button
                  class="btn-secondary px-3 py-2 rounded-md text-sm flex items-center"
                >
                  <svg
                    class="mr-2"
                    fill="none"
                    height="14"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                    width="14"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <circle
                      cx="11"
                      cy="11"
                      r="8"
                    />
                    <path
                      d="m21 21-4.3-4.3"
                    />
                  </svg>
                  Preview OVF descriptor
                </button>
              </div>
              <button
                class="w-full px-4 py-2 rounded-md flex items-center justify-center font-medium bg-blue-600 text-white hover:bg-blue-700 disabled:opacity-50 disabled:bg-app disabled:text-secondary disabled:cursor-not-allowed transition-colors"
                title="Export this VM to an OVA"
              >
                <svg
                  class="mr-2"
                  fill="none"
                  height="16"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  width="16"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
                  />
                  <polyline
                    points="17 8 12 3 7 8"
                  />
                  <line
                    x1="12"
                    x2="12"
                    y1="3"
                    y2="15"
                  />
                </svg>
                Export to OVA
                 (1 disk)
              </button>
              <p
                class="text-xs text-secondary mt-2 text-center"
              >
                Runs as a Kubernetes Job: the VM's disks are mounted read-only, converted with qemu-img, and packaged as an OVA.
              </p>
            </div>
          </div>
        </div>
        <div
          class="mt-6"
        >
          <div
            class="flex items-center justify-between mb-2"
          >
            <h3
              class="text-lg font-semibold text-main"
            >
              Exports
            </h3>
            <button
              class="btn-secondary px-3 py-1.5 rounded-md flex items-center text-xs"
            >
              <svg
                class="mr-2"
                fill="none"
                height="14"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="14"
                xmlns="http://www.w3.org/2000/svg"
