                    name="export-profile"
                    type="radio"
                  />
                  <span
                    class="flex-1"
                  >
                    <span
                      class="block text-main font-medium text-sm"
                    >
                      VMware / vSphere
                    </span>
                    <span
                      class="block text-secondary text-xs mt-0.5"
                    >
                      OVF 1.1 with VMware extensions. virtio devices are remapped to LSI Logic SCSI and E1000E, the hardware ESXi implements.
                    </span>
                  </span>
                </label>
                <label
                  class="flex items-start p-3 border rounded-md cursor-pointer border-main"
                >
                  <input
                    class="mt-1 mr-3"
