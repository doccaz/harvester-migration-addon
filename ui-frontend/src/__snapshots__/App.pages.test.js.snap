      </div>
    </div>
    <div
      class="fixed inset-0 bg-opacity-50 flex justify-center items-center p-4 z-50"
    >
      <div
        class="bg-card rounded-lg shadow-xl w-full max-w-lg max-h-[90vh] overflow-y-auto"
      >
        <div
          class="p-4 border-b"
        >
          <h2
            class="text-xl font-semibold"
          >
            Edit Plan: 
            fresh-plan
          </h2>
          <p
            class="text-xs text-secondary mt-1"
          >
            Adjust plan fields to fix an invalid plan, then re-run it.
          </p>
        </div>
        <div
          class="p-6 space-y-4"
        >
          <div>
            <label
              class="block text-sm font-medium text-main"
            >
              VM Name (source)
            </label>
            <input
              class="mt-1 block w-full form-input"
              type="text"
              value="new-vm"
            />
            <p
              class="text-xs text-secondary mt-1"
            >
              Case-sensitive VM name as it appears in vCenter.
            </p>
          </div>
          <div>
            <label
              class="block text-sm font-medium text-main"
            >
              Folder
            </label>
            <input
              class="mt-1 block w-full form-input"
              placeholder="(leave blank for datacenter root)"
              type="text"
              value=""
            />
            <p
              class="text-xs text-secondary mt-1"
            >
              vCenter inventory folder path of the source VM.
            </p>
          </div>
          <div>
            <label
              class="block text-sm font-medium text-main"
            >
              Storage Class
            </label>
            <select
              class="mt-1 block w-full form-input"
            >
              <option
                value=""
              >
                Select storage class
              </option>
              <option
                value="harvester-longhorn"
              >
                harvester-longhorn
              </option>
              <option
                value="harvester-1replica"
              >
                harvester-1replica
              </option>
            </select>
          </div>
          <div>
            <label
              class="block text-sm font-medium text-main"
            >
              Network Mapping
            </label>
            <p
              class="text-xs text-secondary mt-1 italic"
            >
              No source networks recorded on this plan.
            </p>
          </div>
          <div
            class="border-t pt-4 space-y-4"
          >
            <h4
              class="text-sm font-medium text-main"
            >
              Advanced Options
            </h4>
            <div
              class="flex items-center"
            >
              <input
                class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-main rounded"
                id="editForcePowerOff"
                type="checkbox"
              />
              <label
                class="ml-2 block text-sm text-main"
                for="editForcePowerOff"
              >
                Force Power Off Source VM
              </label>
            </div>
            <div
              class="flex items-center"
            >
              <input
                class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-main rounded"
                id="editSkipPreflight"
                type="checkbox"
              />
              <label
                class="ml-2 block text-sm text-main"
                for="editSkipPreflight"
              >
                Skip Preflight Checks
              </label>
            </div>
            <div>
              <label
                class="block text-sm font-medium text-main"
              >
                Graceful Shutdown Timeout (Seconds)
              </label>
              <input
                class="mt-1 block w-full form-input text-sm"
                placeholder="e.g. 300"
                type="number"
                value=""
              />
            </div>
            <div>
              <label
                class="block text-sm font-medium text-main"
              >
                Default Network Interface Model
              </label>
              <select
                class="mt-1 block w-full form-select text-sm"
              >
                <option
                  value=""
                >
                  Auto (Default)
                </option>
                <option
                  value="e1000"
                >
                  e1000
                </option>
                <option
                  value="e1000e"
                >
                  e1000e
                </option>
                <option
                  value="ne2k_pci"
                >
                  ne2k_pci
                </option>
                <option
                  value="pcnet"
                >
                  pcnet
                </option>
                <option
                  value="rtl8139"
                >
                  rtl8139
                </option>
                <option
                  value="virtio"
                >
                  virtio
                </option>
              </select>
            </div>
            <div>
              <label
                class="block text-sm font-medium text-main"
              >
                Default Disk Bus Type
              </label>
              <select
                class="mt-1 block w-full form-select text-sm"
              >
                <option
                  value=""
                >
                  Auto (Default)
                </option>
                <option
                  value="virtio"
                >
                  virtio (High Performance)
                </option>
                <option
                  value="scsi"
                >
                  scsi
                </option>
                <option
                  value="sata"
                >
                  sata
                </option>
                <option
                  value="usb"
                >
                  usb
                </option>
              </select>
            </div>
          </div>
        </div>
        <div
          class="p-4 border-t flex justify-end space-x-2"
        >
          <button
            class="btn-secondary"
          >
            Cancel
          </button>
          <button
            class="bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded-md"
          >
            Save
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
`;

